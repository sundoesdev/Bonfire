{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth",
  "version": "0.1.0",
  "identifier": "com.bonfire.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hearth",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "publisher": "sundoesdev",
    "copyright": "© 2026 sundoesdev",
    "shortDescription": "Active-recall spaced-repetition study tool",
    "longDescription": "Hearth is a developer-first active-recall study tool with SM-2 and FSRS spaced repetition, decks and subjects, multiple card types, media attachments, markdown-lite, and study analytics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
